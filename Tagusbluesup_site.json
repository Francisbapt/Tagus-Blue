        }
      },

      "faq": {
        "questions": [
          {
            "question": { "pt": "Preciso de experiência?", "en": "Do I need prior experience?" },
            "answer": { "pt": "Não. As nossas atividades de experimentação de kayak e SUP são pensadas para quem nunca praticou.", "en": "No. Our trial sessions are designed for absolute beginners." }
          },
          {
            "question": { "pt": "É obrigatório saber nadar?", "en": "Do I need to know how to swim?" },
            "answer": { "pt": "Sim, por razões de segurança é requisito essencial saber nadar.", "en": "Yes, for safety reasons knowing how to swim is mandatory." }
          },
          {
            "question": { "pt": "O equipamento está incluído?", "en": "Is equipment included?" },
            "answer": { "pt": "Sim. Prancha/kayak, pagaia, colete de salvação e seguro estão incluídos.", "en": "Yes. Board/kayak, paddle, life jacket, and insurance are included." }
          },
          {
            "question": { "pt": "O que devo levar?", "en": "What should I bring?" },
            "answer": { "pt": "Roupa confortável que possa molhar-se, fato de banho, proteção solar, toalha e água.", "en": "Comfortable swimwear/clothes that can get wet, sunscreen, towel, and water." }
          },
          {
            "question": { "pt": "Posso reservar para crianças?", "en": "Can I book for children?" },
            "answer": { "pt": "Sim. Kayak duplo a partir dos 6 anos (acompanhadas por adulto) e SUP a partir dos 10 anos.", "en": "Yes. Double kayak from age 6 (with adult) and SUP from age 10." }
          },
          {
            "question": { "pt": "E se estiver mau tempo?", "en": "What if weather conditions are bad?" },
            "answer": { "pt": "A segurança está em primeiro lugar. Se o vento ou estado do Tejo não permitirem a atividade, reagendamos ou reembolsamos.", "en": "Safety comes first. If weather or water conditions prevent the activity, we reschedule or issue a refund." }
          }
        ]
